---
import CopyBlock from './CopyBlock.astro';
import Icon from './HomeIcon.astro';
import HomeLight from './HomeLight.astro';
import { prompts } from '../data/prompts';
interface Props { lang: 'zh-CN' | 'en'; }
const { lang } = Astro.props;
const en = lang === 'en';
const root = '/Clackly/' + (en ? 'en/' : '');
const docs = root + 'docs/';
const release = 'https://github.com/Wutpeach/Clackly/releases/tag/v0.1.6';
const title = en ? 'Clackly — Stay in the edit.' : 'Clackly — 剪辑，不必绕路。';
const description = en ? 'A compact, keyboard-first command palette for DaVinci Resolve. Find commands, run trusted extensions and build your own tools with AI.' : 'DaVinci Resolve 内轻量、键盘优先的命令面板。搜索命令、运行可信扩展，用 AI 构建自己的剪辑工具。';
const images = '/Clackly/images/home/';
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title><meta name="description" content={description} />
  <meta name="theme-color" content="#151619" />
  <link rel="icon" type="image/x-icon" sizes="16x16 32x32 48x48" href="/Clackly/favicon.ico?v=252b7f13" />
  <link rel="icon" type="image/svg+xml" href="/Clackly/favicon.svg?v=e4fe9146" />
  <link rel="canonical" href={'https://wutpeach.github.io' + root} />
  <link rel="alternate" hreflang="zh-CN" href="https://wutpeach.github.io/Clackly/" />
  <link rel="alternate" hreflang="en" href="https://wutpeach.github.io/Clackly/en/" />
  <link rel="alternate" hreflang="x-default" href="https://wutpeach.github.io/Clackly/" />
  <meta property="og:type" content="website" /><meta property="og:title" content={title} />
  <meta property="og:description" content={description} /><meta property="og:url" content={'https://wutpeach.github.io' + root} />
  <meta property="og:image" content="https://wutpeach.github.io/Clackly/images/home/social.png" />
  <meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={description} /><meta name="twitter:card" content="summary_large_image" />
</head>
<body>
<a class="skip" href="#main">{en ? 'Skip to content' : '跳到正文'}</a>
<header class="wrap header">
  <a class="brand" href={root} aria-label="Clackly"><img src="/Clackly/clackly-compact.svg" width="34" height="34" alt="" /><span>Clackly</span></a>
  <nav aria-label={en ? 'Main navigation' : '主导航'}>
    <a href={docs}>{en ? 'Documentation' : '使用文档'}</a>
    <a href={docs + 'developer/'}>Build with AI</a>
    <a class="github" href="https://github.com/Wutpeach/Clackly">GitHub <Icon name="external" /></a>
    <a class="language" href={en ? '/Clackly/' : '/Clackly/en/'} lang={en ? 'zh-CN' : 'en'}>{en ? '简体中文' : 'English'}</a>
  </nav>
</header>
<main id="main">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-light" aria-hidden="true"><HomeLight /></div>
    <div class="wrap hero-copy">
      <h1 id="hero-title">{en ? 'Stay in the edit.' : <><span>剪辑，</span><span>不必绕路。</span></>}</h1>
      <p class="hero-description">{en ? 'Your next move, one keystroke away.' : '下一步操作，一次呼出。'}<br /><span>{en ? 'A keyboard-first command palette for DaVinci Resolve.' : '为 DaVinci Resolve 而造的键盘优先命令面板。'}</span></p>
      <div class="actions"><a class="button primary" href={release}><Icon name="windows" />{en ? 'Download for Windows' : '下载 Windows 版'}<Icon name="download" /></a><a class="button secondary" href={docs}>{en ? 'Read the docs' : '阅读文档'}<Icon name="arrow" /></a></div>
      <p class="release">v0.1.6 <span>·</span> Windows x64 <span>·</span> {en ? 'Resolve Studio Workflow Integration' : 'Resolve Studio 工作流集成'}</p>
    </div>
    <figure class="wrap product-figure">
      <div class="product-stage">
        <div class="stage-copy"><p>{en ? 'Less reaching.' : '少一点寻找。'}<br /><span>{en ? 'More creating.' : '多一点创作。'}</span></p><div class="shortcut" aria-label="Control plus Space"><kbd>Ctrl</kbd><span>+</span><kbd>Space</kbd></div><span class="shortcut-note">{en ? 'Call up your commands.' : '随手呼出你的命令。'}</span></div>
        <div class="timeline" aria-hidden="true">
          <div class="time-ruler"><span>01:00:00:00</span><span>01:00:04:00</span><span>01:00:08:00</span><span>01:00:12:00</span></div>
          <div class="track video-track"><span>V2</span><i></i><i></i><i></i></div>
          <div class="track main-track"><span>V1</span><i></i><i></i><i></i><i></i></div>
          <div class="track audio-track"><span>A1</span><i></i><i></i></div>
          <div class="playhead"></div>
        </div>
        <div class="product-capture">
          <img id="preview-launcher" data-scene="launcher" src={images + 'launcher.png'} width="512" height="672" alt={en ? 'Actual Clackly Launcher: Pinned, Recent and Commands, with Export to After Effects, Paste Clipboard Image and Add Marker. Demonstration data.' : 'Clackly Launcher 真实界面：Pinned、Recent、Commands 分组，包含 AE 导出、粘贴剪贴板图片和添加标记。使用演示数据。'} fetchpriority="high" />
          <img id="preview-search" data-scene="search" src={images + 'search.png'} width="512" height="672" alt={en ? 'Actual Clackly Search showing commands from Clackly and Resolve scripts. Demonstration data.' : 'Clackly 搜索真实界面：展示 Clackly 和 Resolve 脚本命令，区分不同来源。使用演示数据。'} hidden />
        </div>
        <div class="preview-switch" role="group" aria-label={en ? 'Product screenshot' : '产品界面展示'} data-preview-switch hidden>
          <button type="button" data-scene-target="launcher" aria-controls="preview-launcher" aria-pressed="true">Launcher</button><button type="button" data-scene-target="search" aria-controls="preview-search" aria-pressed="false">{en ? 'Search' : '搜索'}</button>
        </div>
      </div>
      <figcaption>{en ? 'Actual Clackly interface · demo data. Timeline background is a schematic, not a Resolve capture.' : '真实 Clackly 界面 · 演示数据。背景为时间线示意，并非 Resolve 截图。'}</figcaption>
    </figure>
  </section>

  <section class="wrap capabilities" aria-labelledby="work-title">
    <div class="section-heading" data-reveal="text"><h2 id="work-title">{en ? 'Small palette.\nA lot within reach.' : '小面板，\n装得下你的工作流。'}</h2><p>{en ? 'From the command you use every day to the tool you wish existed. Keep it all close to the edit.' : '从每天都用的一个命令，到专属你的一套工具。\n让操作靠近你，让注意力留在剪辑里。'}</p></div>
    <div class="feature-grid">
      <article class="search-feature" data-reveal="product">
        <div class="feature-copy"><h3>{en ? 'Find your next move.' : '想到，就能找到。'}</h3><p>{en ? 'Commands, extensions and Resolve scripts in one search. Pin your favorites. Return to your Recent.' : '内置命令、扩展和 Resolve 脚本，一起搜索。\n常用的固定，用过的从 Recent 找回。'}</p></div>
        <div class="search-art"><img src={images + 'search.png'} width="512" height="672" loading="lazy" alt={en ? 'Real Search interface with demo clipboard commands from different sources.' : '搜索真实界面，以剪贴板演示命令展示不同来源。'} /></div>
        <div class="feature-footer"><span>{en ? 'Actual interface · demo data' : '真实界面 · 演示数据'}</span><a href={docs + 'launcher/'}>{en ? 'Explore Launcher' : '了解 Launcher'}<Icon name="arrow" /></a></div>
      </article>
      <article class="extension-feature" data-reveal="product">
        <div class="feature-copy"><h3>{en ? 'A command. Or a whole tool.' : '一个命令，也能是一套工具。'}</h3><p>{en ? 'Go further with Extension Views. Browse a list, inspect details, fill a form. Your tools, rendered by Clackly.' : '用 Extension View 浏览列表、查看详情、填写表单。\n你的工具，由 Clackly 统一呈现。'}</p></div>
        <div class="extension-art"><img src={images + (en ? 'extension-en.png' : 'extension-zh.png')} width="1120" height="760" loading="lazy" alt={en ? 'Actual Extension View renderer displaying an illustrative read-only Timeline Browser with four demonstration timelines.' : 'Extension View 真实界面：只读时间线浏览器示例，包含四条演示时间线。'} /></div>
        <div class="feature-footer"><span>{en ? 'Example extension · actual interface · demo data' : '示例扩展 · 真实界面 · 演示数据'}</span><a href={docs + 'command-ui-views/'}>{en ? 'Explore extension UI' : '了解扩展界面'}<Icon name="arrow" /></a></div>
      </article>
    </div>
    <div class="extension-note" data-reveal="text"><div class="package-mark" aria-hidden="true">.clackly</div><div><h3>{en ? 'Your workflow has room to grow.' : '让你的工作流，继续生长。'}</h3><p>{en ? 'Install, configure and update trusted extensions in Settings. New commands appear without a restart.' : '在 Settings 安装、配置和更新可信扩展。新命令即刻加入 Launcher，无需重启。'}</p></div><a class="text-link" href={docs + 'extensions/'}>{en ? 'Manage extensions' : '管理扩展'}<Icon name="arrow" /></a></div>
  </section>

  <section class="wrap ai-section" data-reveal="panel" aria-labelledby="ai-title">
    <div class="ai-copy"><h2 id="ai-title">{en ? 'Your workflow.\nYour next idea.' : '你的工作流，\n你的专属工具。'}</h2><p>{en ? 'Tell your Agent what you need. The official Developer Skill brings the protocol, examples and packaging tools to build a Clackly extension.' : '把想法告诉 Agent。官方 Developer Skill 提供协议、示例和打包工具，把一句需求变成可安装的 Clackly 扩展。'}</p><a class="button dark" href={docs + 'developer/'}>Build with AI <Icon name="arrow" /></a><p class="ai-note">{en ? 'Python extensions · Host-rendered UI · Your source to keep' : 'Python 扩展 · Host 渲染界面 · 源码由你掌握'}</p></div>
    <div class="ai-workbench">
      <div class="idea"><Icon name="command" /><p>{en ? '“Build a read-only tool that shows my current project and timeline count.”' : '“做一个只读工具，告诉我当前项目名称和时间线数量。”'}</p></div>
      <div class="build-path"><span>{en ? 'Your idea' : '你的需求'}</span><Icon name="arrow" /><span>Agent + Developer Skill</span><Icon name="arrow" /><span>.clackly</span></div>
      <details><summary>{en ? 'Get the full starter prompt' : '获取完整起步提示词'}</summary><CopyBlock text={prompts(lang)[0].text} lang={lang} label={en ? 'Start with a read-only tool' : '从只读工具开始'} /></details>
    </div>
  </section>

  <section class="wrap closing" data-reveal="text" aria-labelledby="closing-title"><img src="/Clackly/clackly-compact.svg" width="68" height="68" loading="lazy" alt="" /><h2 id="closing-title">{en ? 'Back to the work you love.' : '回到你热爱的剪辑。'}</h2><p class="closing-description">{en ? 'A little less friction. A little more flow.' : '让操作更顺手，让创作更尽兴。'}</p><div class="actions"><a class="button primary" href={release}><Icon name="download" />{en ? 'Get Clackly v0.1.6' : '下载 Clackly v0.1.6'}</a><a class="button secondary" href={docs + 'install/'}>{en ? 'Installation guide' : '安装指南'}<Icon name="arrow" /></a></div><p class="trust-note">{en ? 'Windows x64 · Resolve Studio Workflow Integration. Unsigned installer: download from the official Release and verify its SHA-256. Extensions execute local code; install only sources you trust.' : 'Windows x64 · Resolve Studio 工作流集成。安装器未签名，请从官方 Release 下载并核对 SHA-256。扩展会执行本地代码，请只安装你信任的来源。'}</p></section>
</main>
<footer class="wrap footer"><div><a class="brand" href={root}><img src="/Clackly/clackly-compact.svg" width="28" height="28" alt="" /><span>Clackly</span></a><p>{en ? 'Built for your Resolve workflow.' : '为你的 Resolve 工作流而造。'}</p></div><nav aria-label={en ? 'Footer' : '页脚'}><a href={docs}>{en ? 'Documentation' : '使用文档'}</a><a href={docs + 'developer/'}>Build with AI</a><a href={release}>{en ? 'Releases' : '发行记录'}</a><a href="https://github.com/Wutpeach/Clackly">GitHub</a><a href="/Clackly/fonts/HARMONYOS_SANS_LICENSE.txt">HarmonyOS Sans © Huawei</a></nav></footer>
</body></html>

<script>
  const controls = document.querySelector<HTMLElement>('[data-preview-switch]');
  if (controls) {
    controls.hidden = false;
    controls.querySelectorAll<HTMLButtonElement>('button').forEach((button) => {
      button.addEventListener('click', () => {
        controls.querySelectorAll('button').forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
        document.querySelectorAll<HTMLImageElement>('[data-scene]').forEach((img) => { img.hidden = img.dataset.scene !== button.dataset.sceneTarget; });
      });
    });
  }

  // Progressive enhancement: content starts readable, including without JS.
  const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (!motionPreference.matches && 'IntersectionObserver' in window) {
    const sections = [...document.querySelectorAll<HTMLElement>('[data-reveal]')];
    const reveal = (section: HTMLElement) => {
      section.classList.remove('reveal-pending');
      observer.unobserve(section);
    };
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) reveal(entry.target as HTMLElement);
      });
    }, { threshold: .12, rootMargin: '0px 0px -6% 0px' });
    sections.forEach((section) => {
      // Never fade out content that is already in the visitor's viewport.
      if (section.getBoundingClientRect().top < window.innerHeight) return;
      section.classList.add('reveal-pending');
      observer.observe(section);
      section.addEventListener('focusin', () => {
        section.style.transition = 'none';
        reveal(section);
      }, { once: true });
    });
    motionPreference.addEventListener('change', (event) => {
      if (event.matches) {
        observer.disconnect();
        sections.forEach(reveal);
      }
    });
  }
</script>

<style>
@font-face { font-family: Harmony; src: url('/Clackly/fonts/HarmonyOS_Sans.ttf') format('truetype'); font-display: swap; }
:global(html) { background: #151619; color: #e7e8ea; font-family: Harmony, 'Segoe UI', system-ui, sans-serif; color-scheme: dark; scrollbar-color: #66676e #151619; }
:global(body) { margin: 0; }
:global(*) { box-sizing: border-box; }
:global([hidden]) { display: none !important; }
:global(::selection) { color: #17191d; background: #e7e8ea; }
:global(a) { color: inherit; text-decoration: none; text-underline-offset: .25em; }
:global(a:hover) { text-decoration: underline; }
:global(:focus-visible) { outline: 2px solid #e7e8ea; outline-offset: 5px; }
.wrap { width: min(1200px, calc(100% - 80px)); margin-inline: auto; }
.header { position: relative; z-index: 5; display: flex; justify-content: space-between; align-items: center; gap: 2rem; min-height: 68px; margin-top: 20px; padding: 0 24px; border: 1px solid #ffffff16; border-radius: 13px; background: linear-gradient(115deg, #ffffff09, #ffffff02 55%); box-shadow: 0 12px 35px #00000024, inset 0 1px #ffffff05; }
.brand { display: inline-flex; align-items: center; gap: .7rem; font-size: 1.25rem; font-weight: 600; letter-spacing: -.025em; }
.brand img { display: block; }
.header nav, .footer nav { display: flex; flex-wrap: wrap; align-items: center; gap: 1.8rem; font-size: .83rem; }
.header nav a { display: inline-flex; align-items: center; gap: .25rem; padding-block: .8rem; color: #bebdc3; }
.header nav a:hover { color: #fff; }
.github :global(svg) { width: 14px; height: 14px; }
.header .language { border-left: 1px solid #ffffff1c; padding-left: 1.7rem; }
.hero { position: relative; isolation: isolate; overflow: clip; padding-bottom: 8px; }
.hero-light { position: absolute; z-index: -1; pointer-events: none; top: -157px; left: 50%; width: 1500px; transform: translateX(-50%); opacity: .9; }
.hero-copy { position: relative; text-align: center; padding-block: 80px 48px; }
h1 { font-size: clamp(3.5rem, 6.3vw, 5.65rem); font-weight: 600; line-height: 1.12; letter-spacing: -.04em; margin: 0; text-wrap: balance; text-shadow: 0 3px 26px #151619cc; }
h1 > span { display: inline-block; }
.hero-description { font-size: 1.15rem; line-height: 1.75; margin: 25px 0 28px; color: #e5e7eb; }
.hero-description span { color: #a6a6a8; font-size: .96rem; }
.actions { display: flex; flex-wrap: wrap; gap: .8rem; align-items: center; justify-content: center; }
.button { display: inline-flex; align-items: center; justify-content: center; gap: .7rem; padding: .9rem 1.2rem; border: 1px solid transparent; border-radius: 8px; min-height: 50px; font-weight: 600; font-size: .9rem; transition: background-color 160ms, border-color 160ms, box-shadow 160ms; }
.primary { background: #e7e8ea; color: #151619; border-color: #ffffffb3; box-shadow: 0 7px 24px #e7e8ea15, inset 0 1px #fff; }
.primary:hover { background: #fff; text-decoration: none; box-shadow: 0 7px 30px #e7e8ea30; }
.secondary { border-color: #ffffff26; color: #e0e1e4; background: linear-gradient(#ffffff09, #ffffff03); box-shadow: inset 0 1px #ffffff06; }
.secondary:hover { border-color: #ffffff4a; background-color: #ffffff09; text-decoration: none; }
.release { color: #a6a6a8; font-size: .7rem; line-height: 1.7; margin: 18px 0 0; }
.release span { margin-inline: .4rem; color: #77787b; }
.product-figure { position: relative; margin-block: 0; }
.product-stage { height: 500px; position: relative; overflow: hidden; border: 1px solid #ffffff20; border-radius: 18px; isolation: isolate; background: #111215; box-shadow: 0 35px 75px #00000080, 0 -7px 65px -25px #d5d6dc40, inset 0 0 0 7px #ffffff02; }
.product-stage::before { content: ''; position: absolute; z-index: 5; left: 6%; right: 6%; top: 0; height: 1px; background: linear-gradient(90deg, transparent, #e5e7eb9c 40%, #ffffffb3 66%, transparent); }
.product-stage::after { content: ''; position: absolute; z-index: -1; inset: 0; background: radial-gradient(ellipse at 67% 32%, #c8c9cc1f, transparent 54%), radial-gradient(ellipse at 20% 95%, #c5c7cd0b, transparent 60%); }
.stage-copy { position: absolute; left: 6%; top: 114px; z-index: 2; }
.stage-copy p { font-size: clamp(1.8rem, 2.7vw, 2.3rem); line-height: 1.35; letter-spacing: -.035em; margin: 0 0 30px; font-weight: 500; }
.stage-copy p span { color: #a6a6a8; }
.shortcut { display: flex; align-items: center; gap: .6rem; }
.shortcut kbd { font: 500 .9rem/1 Harmony, sans-serif; border: 1px solid #ffffff2b; border-bottom-color: #ffffff13; background: linear-gradient(#29292d, #18191c); box-shadow: 0 5px 9px #0006, inset 0 1px #ffffff12; border-radius: 7px; padding: .75rem .9rem; }
.shortcut > span, .shortcut-note { color: #a6a6a8; font-size: .75rem; }
.shortcut-note { display: block; margin-top: 15px; }
.product-capture { position: absolute; width: 334px; right: 22%; top: 24px; z-index: 3; }
.product-capture img { width: 100%; height: auto; display: block; filter: drop-shadow(0 25px 24px #000c) drop-shadow(0 -7px 20px #f1f2f418); }
.preview-switch { position: absolute; z-index: 4; right: 25px; bottom: 25px; padding: 4px; border-radius: 9px; display: flex; gap: 4px; background: linear-gradient(#242529, #141417); border: 1px solid #ffffff25; box-shadow: 0 6px 18px #0006, inset 0 1px #ffffff08; }
.preview-switch button { font: 400 .76rem Harmony, sans-serif; color: #b7b8bd; border: 1px solid transparent; background: transparent; padding: .6rem .85rem; border-radius: 5px; min-height: 40px; cursor: pointer; }
.preview-switch button[aria-pressed=true] { background: linear-gradient(#e7e8ea, #d5d7da); border-color: #fff7; color: #17191d; box-shadow: 0 2px 6px #0005; }
.preview-switch button:hover { text-decoration: underline; text-underline-offset: 4px; }
.timeline { position: absolute; width: 125%; left: -12%; bottom: -12px; padding: 20px 0 30px; transform: perspective(1100px) rotateX(38deg) rotateZ(-11deg); transform-origin: center bottom; border-block: 1px solid #ffffff16; background: #0b0d12; z-index: 1; opacity: .62; mask-image: linear-gradient(90deg, transparent, #000 22%, #000 73%, transparent); }
.time-ruler { display: flex; justify-content: space-around; margin: 0 0 12px 48px; padding-bottom: 12px; border-bottom: 1px solid #ffffff19; font-size: .65rem; font-variant-numeric: tabular-nums; color: #a0a2a8; }
.track { display: flex; align-items: stretch; gap: 6px; height: 38px; margin-block: 6px; padding-right: 18px; }
.track > span { width: 52px; flex-shrink: 0; padding: 12px 18px 0; color: #a1a4ab; font-size: .65rem; }
.track i { display: block; height: 100%; border: 1px solid #a0a2ab35; border-radius: 3px; background: linear-gradient(100deg, #3b3d4388, #25262a55); flex: 2; box-shadow: inset 0 1px #ffffff07; }
.video-track i:first-of-type { flex: 1.5; margin-left: 15%; background: linear-gradient(90deg, #52545b55, #393a4088); border-color: #b7b9c040; }
.video-track i:nth-of-type(2) { flex: 1; background: #55565e44; border-color: #b7b9c040; }
.video-track i:last-of-type { background: transparent; border-color: transparent; }
.main-track i:nth-of-type(2) { flex: 3; background: #55576144; }
.main-track i:nth-of-type(3) { flex: 1; background: #5d606c55; }
.audio-track { height: 30px; }
.audio-track i { background: repeating-linear-gradient(90deg, transparent 0 5px, #a0c1ad22 5px 7px), #23312d44; border-color: #82ab9440; }
.audio-track i:last-of-type { flex: 1; }
.playhead { position: absolute; left: 43%; width: 1px; top: 15px; bottom: 0; background: #e7e8ea; box-shadow: 3px 0 18px #e7e8ea55; }
.playhead::before { content: ''; position: absolute; top: 0; left: -4px; width: 9px; height: 9px; background: #e7e8ea; border-radius: 2px; }
figcaption { font-size: .7rem; color: #9a989e; text-align: center; line-height: 1.7; margin-top: 20px; }
.capabilities { padding-block: 135px 100px; }
.section-heading { display: flex; justify-content: space-between; align-items: end; gap: 4rem; margin-bottom: 100px; }
h2 { font-size: clamp(2rem, 3.7vw, 3.25rem); font-weight: 500; letter-spacing: -.035em; line-height: 1.2; white-space: pre-line; text-wrap: balance; margin: 0; }
.section-heading > p { max-width: 27rem; color: #a6a6a8; font-size: .95rem; line-height: 1.9; white-space: pre-line; margin: 0 0 .3rem; }
