---
import CopyBlock from './CopyBlock.astro';
import Icon from './HomeIcon.astro';
import { prompts } from '../data/prompts';
interface Props { lang: 'zh-CN' | 'en'; }
const { lang } = Astro.props;
const en = lang === 'en';
const root = '/Clackly/' + (en ? 'en/' : '');
const docs = root + 'docs/';
const release = 'https://github.com/Wutpeach/Clackly/releases/tag/v0.1.6';
const title = en ? 'Clackly — Stay in the edit.' : 'Clackly — 剪辑，不必绕路。';
const description = en ? 'A compact, keyboard-first command palette for DaVinci Resolve. Find commands, run trusted extensions and build your own tools with AI.' : 'DaVinci Resolve 内轻量、键盘优先的命令面板。搜索命令、运行可信扩展，用 AI 构建自己的剪辑工具。';
const images = '/Clackly/images/home/';
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title><meta name="description" content={description} />
  <meta name="theme-color" content="#151619" />
  <link rel="icon" type="image/x-icon" sizes="16x16 32x32 48x48" href="/Clackly/favicon.ico?v=9980b5a6" />
  <link rel="icon" type="image/svg+xml" href="/Clackly/favicon.svg?v=0e879fa7" />
  <link rel="canonical" href={'https://wutpeach.github.io' + root} />
  <link rel="alternate" hreflang="zh-CN" href="https://wutpeach.github.io/Clackly/" />
  <link rel="alternate" hreflang="en" href="https://wutpeach.github.io/Clackly/en/" />
  <meta property="og:type" content="website" /><meta property="og:title" content={title} />
  <meta property="og:description" content={description} /><meta property="og:url" content={'https://wutpeach.github.io' + root} />
  <meta property="og:image" content="https://wutpeach.github.io/Clackly/images/home/social.png" />
  <meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={description} /><meta name="twitter:card" content="summary_large_image" />
</head>
<body>
<a class="skip" href="#main">{en ? 'Skip to content' : '跳到正文'}</a>
<header class="wrap header">
  <a class="brand" href={root} aria-label="Clackly"><img src="/Clackly/clackly-compact.svg" width="34" height="34" alt="" /><span>Clackly</span></a>
  <nav aria-label={en ? 'Main navigation' : '主导航'}>
    <a href={docs}>{en ? 'Documentation' : '使用文档'}</a>
    <a href={docs + 'developer/'}>Build with AI</a>
    <a class="github" href="https://github.com/Wutpeach/Clackly">GitHub <Icon name="external" /></a>
    <a class="language" href={en ? '/Clackly/' : '/Clackly/en/'} lang={en ? 'zh-CN' : 'en'}>{en ? '简体中文' : 'English'}</a>
  </nav>
</header>
<main id="main">
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap hero-copy">
      <h1 id="hero-title">{en ? 'Stay in the edit.' : <><span>剪辑，</span><span>不必绕路。</span></>}</h1>
      <p class="hero-description">{en ? 'Your next move, one keystroke away.' : '下一步操作，一次呼出。'}<br /><span>{en ? 'A keyboard-first command palette for DaVinci Resolve.' : '为 DaVinci Resolve 而造的键盘优先命令面板。'}</span></p>
      <div class="actions"><a class="button primary" href={release}><Icon name="windows" />{en ? 'Download for Windows' : '下载 Windows 版'}<Icon name="download" /></a><a class="button secondary" href={docs}>{en ? 'Read the docs' : '阅读文档'}<Icon name="arrow" /></a></div>
      <p class="release">v0.1.6 <span>·</span> Windows x64 <span>·</span> {en ? 'Resolve Studio Workflow Integration' : 'Resolve Studio 工作流集成'}</p>
    </div>
    <figure class="wrap product-figure">
      <div class="product-stage">
        <div class="stage-copy"><p>{en ? 'Less reaching.' : '少一点寻找。'}<br /><span>{en ? 'More creating.' : '多一点创作。'}</span></p><div class="shortcut" aria-label="Control plus Space"><kbd>Ctrl</kbd><span>+</span><kbd>Space</kbd></div><span class="shortcut-note">{en ? 'Call up your commands.' : '随手呼出你的命令。'}</span></div>
        <div class="timeline" aria-hidden="true">
          <div class="time-ruler"><span>01:00:00:00</span><span>01:00:04:00</span><span>01:00:08:00</span><span>01:00:12:00</span></div>
          <div class="track video-track"><span>V2</span><i></i><i></i><i></i></div>
          <div class="track main-track"><span>V1</span><i></i><i></i><i></i><i></i></div>
          <div class="track audio-track"><span>A1</span><i></i><i></i></div>
          <div class="playhead"></div>
        </div>
        <div class="product-capture">
          <img id="preview-launcher" data-scene="launcher" src={images + 'launcher.png'} width="512" height="672" alt={en ? 'Actual Clackly Launcher: Pinned, Recent and Commands, with Export to After Effects, Paste Clipboard Image and Add Marker. Demonstration data.' : 'Clackly Launcher 真实界面：Pinned、Recent、Commands 分组，包含 AE 导出、粘贴剪贴板图片和添加标记。使用演示数据。'} fetchpriority="high" />
          <img id="preview-search" data-scene="search" src={images + 'search.png'} width="512" height="672" alt={en ? 'Actual Clackly Search showing commands from Clackly and Resolve scripts. Demonstration data.' : 'Clackly 搜索真实界面：展示 Clackly 和 Resolve 脚本命令，区分不同来源。使用演示数据。'} hidden />
        </div>
        <div class="preview-switch" role="group" aria-label={en ? 'Product screenshot' : '产品界面展示'} data-preview-switch hidden>
          <button type="button" data-scene-target="launcher" aria-controls="preview-launcher" aria-pressed="true">Launcher</button><button type="button" data-scene-target="search" aria-controls="preview-search" aria-pressed="false">{en ? 'Search' : '搜索'}</button>
        </div>
      </div>
      <figcaption>{en ? 'Actual Clackly interface · demo data. Timeline background is a schematic, not a Resolve capture.' : '真实 Clackly 界面 · 演示数据。背景为时间线示意，并非 Resolve 截图。'}</figcaption>
    </figure>
  </section>

  <section class="wrap capabilities" aria-labelledby="work-title">
    <div class="section-heading"><h2 id="work-title">{en ? 'Small palette.\nA lot within reach.' : '小面板，\n装得下你的工作流。'}</h2><p>{en ? 'From the command you use every day to the tool you wish existed. Keep it all close to the edit.' : '从每天都用的一个命令，到专属你的一套工具。\n让操作靠近你，让注意力留在剪辑里。'}</p></div>
    <div class="feature-grid">
      <article class="search-feature">
        <div class="feature-copy"><h3>{en ? 'Find your next move.' : '想到，就能找到。'}</h3><p>{en ? 'Commands, extensions and Resolve scripts in one search. Pin your favorites. Return to your Recent.' : '内置命令、扩展和 Resolve 脚本，一起搜索。\n常用的固定，用过的从 Recent 找回。'}</p></div>
        <div class="search-art"><span class="search-orbit" aria-hidden="true"><Icon name="search" /></span><img src={images + 'search.png'} width="512" height="672" loading="lazy" alt={en ? 'Real Search interface with demo clipboard commands from different sources.' : '搜索真实界面，以剪贴板演示命令展示不同来源。'} /></div>
        <div class="feature-footer"><span>{en ? 'Actual interface · demo data' : '真实界面 · 演示数据'}</span><a href={docs + 'launcher/'}>{en ? 'Explore Launcher' : '了解 Launcher'}<Icon name="arrow" /></a></div>
      </article>
      <article class="extension-feature">
        <div class="feature-copy"><h3>{en ? 'A command. Or a whole tool.' : '一个命令，也能是一套工具。'}</h3><p>{en ? 'Go further with Extension Views. Browse a list, inspect details, fill a form. Your tools, rendered by Clackly.' : '用 Extension View 浏览列表、查看详情、填写表单。\n你的工具，由 Clackly 统一呈现。'}</p></div>
        <div class="extension-art"><img src={images + (en ? 'extension-en.png' : 'extension-zh.png')} width="1120" height="760" loading="lazy" alt={en ? 'Actual Extension View renderer displaying an illustrative read-only Timeline Browser with four demonstration timelines.' : 'Extension View 真实界面：只读时间线浏览器示例，包含四条演示时间线。'} /></div>
        <div class="feature-footer"><span>{en ? 'Example extension · actual interface · demo data' : '示例扩展 · 真实界面 · 演示数据'}</span><a href={docs + 'command-ui-views/'}>{en ? 'Explore extension UI' : '了解扩展界面'}<Icon name="arrow" /></a></div>
      </article>
    </div>
    <div class="extension-note"><div class="package-mark" aria-hidden="true">.clackly</div><div><h3>{en ? 'Your workflow has room to grow.' : '让你的工作流，继续生长。'}</h3><p>{en ? 'Install, configure and update trusted extensions in Settings. New commands appear without a restart.' : '在 Settings 安装、配置和更新可信扩展。新命令即刻加入 Launcher，无需重启。'}</p></div><a class="text-link" href={docs + 'extensions/'}>{en ? 'Manage extensions' : '管理扩展'}<Icon name="arrow" /></a></div>
  </section>

  <section class="wrap ai-section" aria-labelledby="ai-title">
    <div class="ai-copy"><h2 id="ai-title">{en ? 'Your workflow.\nYour next idea.' : '你的工作流，\n你的专属工具。'}</h2><p>{en ? 'Tell your Agent what you need. The official Developer Skill brings the protocol, examples and packaging tools to build a Clackly extension.' : '把想法告诉 Agent。官方 Developer Skill 提供协议、示例和打包工具，把一句需求变成可安装的 Clackly 扩展。'}</p><a class="button dark" href={docs + 'developer/'}>Build with AI <Icon name="arrow" /></a><p class="ai-note">{en ? 'Python extensions · Host-rendered UI · Your source to keep' : 'Python 扩展 · Host 渲染界面 · 源码由你掌握'}</p></div>
    <div class="ai-workbench">
      <div class="idea"><Icon name="command" /><p>{en ? '“Build a read-only tool that shows my current project and timeline count.”' : '“做一个只读工具，告诉我当前项目名称和时间线数量。”'}</p></div>
      <div class="build-path"><span>{en ? 'Your idea' : '你的需求'}</span><Icon name="arrow" /><span>Agent + Developer Skill</span><Icon name="arrow" /><span>.clackly</span></div>
      <details><summary>{en ? 'Get the full starter prompt' : '获取完整起步提示词'}</summary><CopyBlock text={prompts(lang)[0].text} lang={lang} label={en ? 'Start with a read-only tool' : '从只读工具开始'} /></details>
    </div>
  </section>

  <section class="wrap closing" aria-labelledby="closing-title"><img src="/Clackly/clackly-compact.svg" width="68" height="68" loading="lazy" alt="" /><h2 id="closing-title">{en ? 'Back to the work you love.' : '回到你热爱的剪辑。'}</h2><p class="closing-description">{en ? 'A little less friction. A little more flow.' : '让操作更顺手，让创作更尽兴。'}</p><div class="actions"><a class="button primary" href={release}><Icon name="download" />{en ? 'Get Clackly v0.1.6' : '下载 Clackly v0.1.6'}</a><a class="button secondary" href={docs + 'install/'}>{en ? 'Installation guide' : '安装指南'}<Icon name="arrow" /></a></div><p class="trust-note">{en ? 'Windows x64 · Resolve Studio Workflow Integration. Unsigned installer: download from the official Release and verify its SHA-256. Extensions execute local code; install only sources you trust.' : 'Windows x64 · Resolve Studio 工作流集成。安装器未签名，请从官方 Release 下载并核对 SHA-256。扩展会执行本地代码，请只安装你信任的来源。'}</p></section>
</main>
<footer class="wrap footer"><div><a class="brand" href={root}><img src="/Clackly/clackly-compact.svg" width="28" height="28" alt="" /><span>Clackly</span></a><p>{en ? 'Built for your Resolve workflow.' : '为你的 Resolve 工作流而造。'}</p></div><nav aria-label={en ? 'Footer' : '页脚'}><a href={docs}>{en ? 'Documentation' : '使用文档'}</a><a href={docs + 'developer/'}>Build with AI</a><a href={release}>{en ? 'Releases' : '发行记录'}</a><a href="https://github.com/Wutpeach/Clackly">GitHub</a><a href="/Clackly/fonts/HARMONYOS_SANS_LICENSE.txt">HarmonyOS Sans © Huawei</a></nav></footer>
</body></html>

<script>
  const controls = document.querySelector<HTMLElement>('[data-preview-switch]');
  if (controls) {
    controls.hidden = false;
    controls.querySelectorAll<HTMLButtonElement>('button').forEach((button) => {
      button.addEventListener('click', () => {
        controls.querySelectorAll('button').forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
        document.querySelectorAll<HTMLImageElement>('[data-scene]').forEach((img) => { img.hidden = img.dataset.scene !== button.dataset.sceneTarget; });
      });
    });
  }
</script>

<style>
@font-face { font-family: Harmony; src: url('/Clackly/fonts/HarmonyOS_Sans.ttf') format('truetype'); font-display: swap; }
:global(html) { background: #151619; color: #eeece8; font-family: Harmony, 'Segoe UI', system-ui, sans-serif; color-scheme: dark; scrollbar-color: #777b84 #151619; }
:global(body) { margin: 0; }
:global(*) { box-sizing: border-box; }
:global([hidden]) { display: none !important; }
:global(::selection) { color: #151619; background: #f0c69c; }
:global(a) { color: inherit; text-decoration: none; text-underline-offset: .25em; }
:global(a:hover) { text-decoration: underline; }
:global(:focus-visible) { outline: 2px solid #f0c69c; outline-offset: 5px; }
.wrap { width: min(1200px, calc(100% - 80px)); margin-inline: auto; }
.header { display: flex; justify-content: space-between; align-items: center; gap: 2rem; min-height: 92px; }
.brand { display: inline-flex; align-items: center; gap: .7rem; font-size: 1.3rem; font-weight: 600; letter-spacing: -.025em; }
.brand img { display: block; }
.header nav, .footer nav { display: flex; flex-wrap: wrap; align-items: center; gap: 1.8rem; font-size: .875rem; }
.header nav a { display: inline-flex; align-items: center; gap: .25rem; padding-block: .8rem; color: #c3c2c6; }
.header nav a:hover { color: #fff; }
.github :global(svg) { width: 15px; height: 15px; }
.header .language { border-left: 1px solid #3c3d42; padding-left: 1.7rem; }
.hero-copy { text-align: center; padding-block: 40px 30px; }
h1 { font-size: clamp(3.5rem, 6.7vw, 6rem); font-weight: 600; line-height: 1.12; letter-spacing: -.04em; margin: 0; text-wrap: balance; }
h1 > span { display: inline-block; }
.hero-description { font-size: 1.2rem; line-height: 1.65; margin: 25px 0 26px; color: #eeece8; }
.hero-description span { color: #b1b0b7; font-size: 1rem; }
.actions { display: flex; flex-wrap: wrap; gap: .75rem; align-items: center; justify-content: center; }
.button { display: inline-flex; align-items: center; justify-content: center; gap: .7rem; padding: .9rem 1.2rem; border: 1px solid transparent; border-radius: 8px; min-height: 50px; font-weight: 600; font-size: .9rem; }
.primary { background: #eeece8; color: #151619; }
.primary:hover { background: #fff; text-decoration: none; }
.secondary { border-color: #414247; color: #dddbd9; background: #1c1d20; }
.secondary:hover { border-color: #777b84; background: #25262a; text-decoration: none; }
.release { color: #a9a8b0; font-size: .73rem; line-height: 1.7; margin: 16px 0 0; }
.release span { margin-inline: .4rem; }
.product-figure { margin-block: 0; }
.product-stage { height: 510px; border: 1px solid #4a403a; border-radius: 16px; position: relative; overflow: hidden; background: linear-gradient(115deg, #282227 0%, #524039 44%, #9e7960 75%, #ccb396 100%); isolation: isolate; animation: stage-arrive 900ms cubic-bezier(.16,1,.3,1) both; }
.stage-copy { position: absolute; left: 6%; top: 52px; z-index: 2; }
.stage-copy p { font-size: clamp(1.8rem, 3vw, 2.5rem); line-height: 1.25; letter-spacing: -.035em; margin: 0 0 25px; font-weight: 500; }
.stage-copy p span { color: #dfcbbd; }
.shortcut { display: flex; align-items: center; gap: .5rem; }
.shortcut kbd { font: 500 .95rem/1 Harmony, sans-serif; border: 1px solid #9a8172; border-bottom-width: 3px; background: #3d3332; border-radius: 7px; padding: .65rem .85rem; }
.shortcut > span, .shortcut-note { color: #d1bdb1; font-size: .78rem; }
.shortcut-note { display: block; margin-top: 12px; }
.product-capture { position: absolute; width: 344px; right: 21%; top: 20px; z-index: 3; }
.product-capture img { width: 100%; height: auto; display: block; filter: drop-shadow(0 18px 23px #160e1170); }
.preview-switch { position: absolute; z-index: 4; right: 24px; top: 24px; padding: 4px; border-radius: 8px; display: flex; gap: 4px; background: #211e20; border: 1px solid #6f5c50; }
.preview-switch button { font: 400 .78rem Harmony, sans-serif; color: #cbc3bd; border: 0; background: transparent; padding: .6rem .8rem; border-radius: 4px; min-height: 36px; cursor: pointer; }
.preview-switch button[aria-pressed=true] { background: #eeece8; color: #151619; }
.preview-switch button:hover { text-decoration: underline; text-underline-offset: 4px; }
.timeline { position: absolute; width: 110%; left: -5%; bottom: -25px; padding: 20px 0 30px; transform: rotate(-5deg); border-block: 1px solid #a2948f60; background: #211f27e8; z-index: 1; }
.time-ruler { display: flex; justify-content: space-around; margin: 0 0 12px 48px; padding-bottom: 12px; border-bottom: 1px solid #6e6371; font-size: .65rem; font-variant-numeric: tabular-nums; color: #b9adbd; }
.track { display: flex; align-items: stretch; gap: 5px; height: 36px; margin-block: 5px; padding-right: 18px; }
.track > span { width: 52px; flex-shrink: 0; padding: 12px 18px 0; color: #c2b5c5; font-size: .65rem; }
.track i { display: block; height: 100%; border: 1px solid #b7a2d05c; border-radius: 3px; background: #63556c; flex: 2; }
.video-track i:first-of-type { flex: 1.5; margin-left: 15%; background: #9e7863; border-color: #c3977c; }
.video-track i:nth-of-type(2) { flex: 1; background: #a07d65; }
.video-track i:last-of-type { background: transparent; border-color: transparent; }
.main-track i:nth-of-type(2) { flex: 3; background: #796283; }
.main-track i:nth-of-type(3) { flex: 1; background: #897096; }
.audio-track { height: 30px; }
.audio-track i { background: repeating-linear-gradient(90deg, transparent 0 5px, #7d92844d 5px 7px), #3b514b; border-color: #638572; }
.audio-track i:last-of-type { flex: 1; }
.playhead { position: absolute; left: 43%; width: 1px; top: 15px; bottom: 0; background: #e9c2a5; }
.playhead::before { content: ''; position: absolute; top: 0; left: -4px; width: 9px; height: 9px; background: #e9c2a5; border-radius: 2px; }
figcaption { font-size: .72rem; color: #a9a8b0; text-align: center; line-height: 1.7; margin-top: 16px; }
.capabilities { padding-block: 120px 100px; }
.section-heading { display: flex; justify-content: space-between; align-items: end; gap: 3rem; margin-bottom: 42px; }
h2 { font-size: clamp(2rem, 3.7vw, 3.25rem); font-weight: 500; letter-spacing: -.035em; line-height: 1.2; white-space: pre-line; text-wrap: balance; margin: 0; }
.section-heading > p { max-width: 29rem; color: #b1b0b7; font-size: 1rem; line-height: 1.85; white-space: pre-line; margin: 0 0 .3rem; }
.feature-grid { display: grid; grid-template-columns: .85fr 1.15fr; gap: 24px; }
.feature-grid article { border-radius: 14px; overflow: hidden; display: flex; flex-direction: column; }
.search-feature { border: 1px solid #36373d; background: #1d1f25; }
.extension-feature { background: #e5ddd2; color: #28252c; }
.feature-copy { padding: 34px 34px 0; }
h3 { font-weight: 500; font-size: clamp(1.3rem, 2vw, 1.65rem); letter-spacing: -.025em; line-height: 1.35; margin: 0; text-wrap: balance; }
.feature-copy p { line-height: 1.8; font-size: .92rem; margin: 14px 0 0; color: #b9b9c3; white-space: pre-line; }
.extension-feature p { color: #615a62; }
.search-art { position: relative; display: grid; place-items: center; padding: 28px 30px 22px; flex: 1; }
.search-art img { width: 238px; max-width: 100%; height: auto; z-index: 1; filter: drop-shadow(0 14px 20px #0005); }
.search-orbit { position: absolute; width: 300px; height: 300px; border: 1px solid #45434f; border-radius: 50%; transform: rotate(-22deg); }
.search-orbit :global(svg) { position: absolute; top: 18px; left: 15px; padding: 10px; width: 44px; height: 44px; background: #31303c; border: 1px solid #55515f; border-radius: 10px; transform: rotate(22deg); }
.extension-art { flex: 1; display: grid; align-items: center; padding: 35px 26px; }
.extension-art img { width: 100%; height: auto; display: block; border-radius: 8px; box-shadow: 0 20px 35px #44312e35; }
.feature-footer { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; align-items: center; padding: 0 34px 28px; }
.feature-footer > span { color: #aaa9b4; font-size: .67rem; line-height: 1.7; }
.extension-feature .feature-footer > span { color: #686069; }
.feature-footer a, .text-link { display: inline-flex; align-items: center; gap: .6rem; font-size: .85rem; padding-block: .6rem; }
.feature-footer a :global(svg), .text-link :global(svg) { width: 17px; height: 17px; }
.extension-note { display: grid; grid-template-columns: auto 1fr auto; gap: 28px; align-items: center; margin-top: 30px; padding: 28px 4px; border-bottom: 1px solid #36373d; }
.package-mark { border: 1px solid #5e5754; border-radius: 8px; padding: 22px 12px; font-size: .85rem; color: #e4b894; background: #292321; }
.extension-note h3 { font-size: 1.1rem; }
.extension-note p { color: #b1b0b7; font-size: .875rem; line-height: 1.8; margin: 8px 0 0; }
.ai-section { color: #262733; background: #d9dbea; border-radius: 16px; padding: 64px 54px; display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 54px; color-scheme: light; --primary: #262733; --primary-foreground: #fff; --border: #a9aabb; }
.ai-copy > p { font-size: .95rem; line-height: 1.85; color: #555666; margin-block: 22px; }
.dark { background: #262733; color: #f2f0f6; }
.dark:hover { background: #3d3e4d; text-decoration: none; }
.ai-copy > .ai-note { font-size: .72rem; margin-bottom: 0; }
.ai-workbench { min-width: 0; }
