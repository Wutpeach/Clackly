<style>
  svg { display: block; width: 100%; height: auto; }
  .light-stroke { stroke-linecap: round; stroke-dasharray: 1; stroke-dashoffset: 0; animation: arc-trace 4000ms cubic-bezier(.4,0,.6,1) both; }
  .light-air { animation: air-settle 4000ms cubic-bezier(.4,0,.6,1) both; }
  @keyframes arc-trace { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  @keyframes air-settle { from { opacity: 0; } 30% { opacity: .08; } to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce), print {
    .light-stroke, .light-air { animation: none; }
  }
</style>