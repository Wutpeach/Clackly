{
  "name": "clackly",
  "version": "0.1.0",
  "private": true,
  "description": "Architecture-validation MVP command palette for DaVinci Resolve.",
  "main": "electron/main/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev-renderer\"",
    "start": "npm run build && electron .",
    "start:electron": "electron .",
    "build": "vite build"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^9.1.0",
    "electron": "^43.2.0",
    "vite": "^8.1.5",
    "wait-on": "^8.0.1"
  }
}
