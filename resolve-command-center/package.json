{
  "name": "clackly",
  "version": "0.1.2",
  "private": true,
  "description": "Architecture-validation MVP command palette for DaVinci Resolve.",
  "main": "electron/main/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev-renderer\"",
    "start": "npm run build && electron .",
    "start:electron": "electron .",
    "build": "vite build",
    "runtime:stage": "powershell -ExecutionPolicy Bypass -File scripts/stage-managed-python.ps1",
    "package:win": "npm run runtime:stage && npm run build && electron-builder --win dir",
    "package:verify": "node scripts/verify-package.js",
    "beta:package": "node scripts/package-internal-beta.js",
    "workflow:release": "node scripts/workflow-release/package.js",
    "workflow:release:test": "node --test scripts/workflow-release/*.test.js",
    "resolve-shortcut-spike:package": "node scripts/package-resolve-shortcut-spike-dev.js",
    "resolve-shortcut-spike:ui-smoke": "node scripts/resolve-shortcut-spike-ui-smoke.mjs",
    "diagnostics:package": "node scripts/package-diagnostic-sampler.js",
    "palette:evidence": "node scripts/palette-evidence.mjs",
    "settings:evidence": "node scripts/palette-evidence.mjs --renderer built --scenario settings-application-empty,settings-typical-ready,settings-actual-ae,settings-no-config,settings-language-menu,settings-missing-config-long-path,settings-zh-cn-multi-help,settings-busy,settings-error,settings-search-match,settings-search-empty,settings-reduced-motion",
    "test": "node scripts/test-groups.js all",
    "workflow:install": "powershell -ExecutionPolicy Bypass -File scripts/install-workflow-plugin.ps1",
    "workflow:install:package": "powershell -ExecutionPolicy Bypass -File scripts/install-workflow-plugin.ps1 -Archive",
    "test:node": "node scripts/test-groups.js node",
    "test:integration": "node scripts/test-groups.js integration",
    "test:python": "node scripts/test-groups.js python",
    "test:list": "node scripts/test-groups.js --list"
  },
  "build": {
    "appId": "com.wutpeach.clackly",
    "productName": "Clackly",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "**/*",
      "!**/WorkflowIntegration.node",
      "!build{,/**/*}",
      "!release{,/**/*}",
      "!resources/runtimes{,/**/*}"
    ],
    "extraResources": [
      {
        "from": "build/runtime-staging/runtimes",
        "to": "runtimes"
      }
    ],
    "win": {
      "target": "dir",
      "signAndEditExecutable": false
    }
  },
  "dependencies": {
    "lucide-react": "^1.27.0",
    "motion": "13.1.1",
    "pinyin-pro": "^3.29.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "semver": "^7.8.5",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.4",
    "agentation": "3.0.2",
    "concurrently": "^9.1.0",
    "electron": "36.3.2",
    "electron-builder": "^26.15.3",
    "playwright": "1.62.1",
    "vite": "^8.1.5",
    "wait-on": "^8.0.1"
  }
}
