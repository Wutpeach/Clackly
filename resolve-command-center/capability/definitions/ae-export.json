{
  "id": "ae.export",
  "name": "Export to After Effects",
  "description": "Send Resolve timeline clips to After Effects",
  "category": "Export",
  "icon": "send",
  "version": "1.0.0",
  "type": "command",
  "providers": ["script"],
  "localizations": {
    "zh-CN": {
      "name": "导出到 After Effects",
      "description": "将 Resolve 时间线片段发送到 After Effects",
      "category": "导出"
    }
  },
  "executor": {
    "type": "script",
    "runtime": "python",
    "entry": "scripts/resolve2ae_export.py"
  },
  "configSchema": {
    "aePath": {
      "type": "path",
      "label": "After Effects Path",
      "required": true,
      "localizations": { "zh-CN": { "label": "After Effects 路径" } }
    },
    "create1080pPreviewComp": {
      "type": "boolean",
      "label": "Create 1080p Preview Comp",
      "localizations": { "zh-CN": { "label": "创建 1080p 预览合成" } }
    }
  }
}
