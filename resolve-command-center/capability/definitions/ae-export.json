{
  "id": "ae.export",
  "name": "Export to After Effects",
  "description": "Send Resolve timeline clips to After Effects",
  "category": "Export",
  "icon": "send",
  "version": "1.0.0",
  "type": "command",
  "providers": ["script"],
  "executor": {
    "type": "script",
