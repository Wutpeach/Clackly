    "entry": "scripts/resolve2ae_export.py"
  },
  "configSchema": {
    "aePath": {
      "type": "path",
      "label": "After Effects Path",
      "required": true
    },
    "prefix": {
      "type": "string",
      "label": "Composition Prefix"
    }
  }
}
